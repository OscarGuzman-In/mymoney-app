generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum movement_type {
  income
  expense
  transfer
  @@map("movement_type")
}

enum account_type {
  cash
  bank_account
  savings_account
  wallet
  @@map("account_type")
}

enum budget_status {
  active
  paused
  completed
  cancelled
  @@map("budget_status")
}

enum savings_goal_status {
  active
  paused
  completed
  cancelled
  @@map("savings_goal_status")
}

enum debt_status {
  active
  paid
  overdue
  cancelled
  @@map("debt_status")
}

enum category_type {
  income
  expense
  @@map("category_type")
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique @db.VarChar(255)
  password   String    @db.VarChar(255)
  first_name String?   @db.VarChar(100)
  last_name  String?   @db.VarChar(100)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  sessions                   Session[]
  accounts                   Account[]
  categories                 Category[]
  payment_methods            PaymentMethod[]
  movements                 Movement[]
  budgets                    Budget[]
  savings_goals              SavingsGoal[]
  debts                      Debt[]
  notifications              Notification[]
  audit_logs                 AuditLog[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String    @db.Uuid
  token        String    @unique @db.VarChar(500)
  expires_at   DateTime  @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  ip_address   String?   @db.VarChar(45)
  user_agent   String?   @db.VarChar(500)

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(100)
  entity_id  String   @db.VarChar(100)
  metadata   Json     @default("{}") @db.JsonB
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([user_id])
  @@index([entity, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model Currency {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique @db.VarChar(3)
  name       String   @db.VarChar(100)
  symbol     String?  @db.VarChar(10)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  accounts     Account[]
  movements    Movement[]
  budgets      Budget[]
  savings_goals SavingsGoal[]
  debts        Debt[]

  @@map("currency")
}

model Account {
  id           String       @id @default(uuid()) @db.Uuid
  user_id      String       @db.Uuid
  currency_id  String       @db.Uuid
  name         String       @db.VarChar(100)
  type         account_type
  description  String?      @db.VarChar(500)
  balance      Decimal      @default(0) @db.Decimal(15, 2)
  is_active    Boolean      @default(true)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime?    @db.Timestamptz(6)

  user          User      @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency      Currency  @relation(fields: [currency_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements_out Movement[] @relation("transfer_out")
  movements_in  Movement[] @relation("transfer_in")

  @@index([user_id])
  @@index([currency_id])
  @@index([type])
  @@index([is_active])
  @@map("accounts")
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  user_id     String?      @db.Uuid
  name        String       @db.VarChar(100)
  type        category_type
  description String?      @db.VarChar(500)
  color       String?      @db.VarChar(7)
  icon        String?      @db.VarChar(50)
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?    @db.Timestamptz(6)

  user              User?              @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  movements         Movement[]
  budget_categories BudgetCategory[]

  @@index([user_id])
  @@index([type])
  @@index([is_active])
  @@map("categories")
}

model PaymentMethod {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  user      User       @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements Movement[]

  @@index([user_id])
  @@index([is_active])
  @@map("payment_methods")
}

model Movement {
  id                  String        @id @default(uuid()) @db.Uuid
  user_id             String        @db.Uuid
  account_id          String        @db.Uuid
  category_id         String?       @db.Uuid
  payment_method_id   String?       @db.Uuid
  currency_id         String        @db.Uuid
  transfer_account_id String?       @db.Uuid
  amount              Decimal       @db.Decimal(15, 2)
  type                movement_type
  description         String?       @db.VarChar(500)
  movement_date       DateTime      @db.Date
  reference           String?       @db.VarChar(100)
  notes               String?       @db.VarChar(1000)
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  user             User           @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account          Account        @relation("transfer_out", fields: [account_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category         Category?      @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  payment_method   PaymentMethod? @relation(fields: [payment_method_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  currency         Currency       @relation(fields: [currency_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transfer_account Account?       @relation("transfer_in", fields: [transfer_account_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([user_id])
  @@index([account_id])
  @@index([category_id])
  @@index([payment_method_id])
  @@index([currency_id])
  @@index([transfer_account_id])
  @@index([type])
  @@index([movement_date])
  @@index([created_at])
  @@map("movements")
}

model Budget {
  id          String        @id @default(uuid()) @db.Uuid
  user_id     String        @db.Uuid
  currency_id String        @db.Uuid
  name        String        @db.VarChar(100)
  amount      Decimal       @db.Decimal(15, 2)
  start_date  DateTime      @db.Date
  end_date    DateTime      @db.Date
  status      budget_status @default(active)
  description String?       @db.VarChar(500)
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  user              User              @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency          Currency          @relation(fields: [currency_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  budget_categories BudgetCategory[]

  @@index([user_id])
  @@index([currency_id])
  @@index([status])
  @@index([start_date, end_date])
  @@map("budgets")
}

model BudgetCategory {
  id          String   @id @default(uuid()) @db.Uuid
  budget_id   String   @db.Uuid
  category_id String   @db.Uuid
  amount      Decimal  @db.Decimal(15, 2)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  budget   Budget   @relation(fields: [budget_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([budget_id, category_id])
  @@index([budget_id])
  @@index([category_id])
  @@map("budget_categories")
}

model SavingsGoal {
  id            String               @id @default(uuid()) @db.Uuid
  user_id       String               @db.Uuid
  currency_id   String               @db.Uuid
  name          String               @db.VarChar(100)
  target_amount Decimal              @db.Decimal(15, 2)
  current_amount Decimal             @default(0) @db.Decimal(15, 2)
  target_date   DateTime             @db.Date
  status        savings_goal_status  @default(active)
  description   String?              @db.VarChar(500)
  is_active     Boolean              @default(true)
  created_at    DateTime             @default(now()) @db.Timestamptz(6)
  updated_at    DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  user                        User                        @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency                    Currency                    @relation(fields: [currency_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  savings_goal_contributions  SavingsGoalContribution[]

  @@index([user_id])
  @@index([currency_id])
  @@index([status])
  @@index([target_date])
  @@map("savings_goals")
}

model SavingsGoalContribution {
  id               String   @id @default(uuid()) @db.Uuid
  savings_goal_id  String   @db.Uuid
  amount           Decimal  @db.Decimal(15, 2)
  contribution_date DateTime @db.Date
  notes            String?  @db.VarChar(500)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  savings_goal SavingsGoal @relation(fields: [savings_goal_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([savings_goal_id])
  @@index([contribution_date])
  @@map("savings_goal_contributions")
}

model Debt {
  id                String      @id @default(uuid()) @db.Uuid
  user_id           String      @db.Uuid
  currency_id       String      @db.Uuid
  name              String      @db.VarChar(100)
  original_amount   Decimal     @db.Decimal(15, 2)
  remaining_amount  Decimal     @db.Decimal(15, 2)
  due_date          DateTime    @db.Date
  status            debt_status @default(active)
  description       String?     @db.VarChar(500)
  is_active         Boolean     @default(true)
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  updated_at        DateTime    @default(now()) @updatedAt @db.Timestamptz(6)

  user          User           @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency      Currency       @relation(fields: [currency_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  debt_payments DebtPayment[]

  @@index([user_id])
  @@index([currency_id])
  @@index([status])
  @@index([due_date])
  @@map("debts")
}

model DebtPayment {
  id           String   @id @default(uuid()) @db.Uuid
  debt_id      String   @db.Uuid
  amount       Decimal  @db.Decimal(15, 2)
  payment_date DateTime @db.Date
  notes        String?  @db.VarChar(500)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  debt Debt @relation(fields: [debt_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([debt_id])
  @@index([payment_date])
  @@map("debt_payments")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  title      String    @db.VarChar(100)
  message    String    @db.VarChar(1000)
  type       String    @db.VarChar(50)
  is_read    Boolean   @default(false)
  read_at    DateTime? @db.Timestamptz(6)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@index([created_at])
  @@map("notifications")
}